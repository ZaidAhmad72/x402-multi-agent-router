# Single shared env file for all 5 agents (research/writer/formatter/weather/
# analysis) — see .env's own header comment for why this replaced one .env
# per agent. Copy this to .env and fill in the real values.
#
# Loaded by every agents/*/index.ts via config({ path: '../../.env' }).

# Shared across all 5 agents
FACILITATOR_URL=https://facilitator.goplausible.xyz
# Required only when MOCK=false (research/writer/analysis).
GROQ_API_KEY=
# MOCK=true uses canned findings/summaries instead of a live LLM call
# (research/writer/analysis only). The x402 payment path is real either way.
MOCK=true

# Per-agent wallet addresses — each agent's own wallet receiving x402
# payments. NOT the mnemonics (those stay in .env.wallets).
#
# PORT is intentionally NOT set here: each agent already has its own
# hardcoded default port (research=4001, writer=4002, formatter=4003,
# weather=4004, analysis=4005). A single shared PORT= in this file would
# make every agent try to bind the same port.
AVM_ADDRESS_RESEARCH=
AVM_ADDRESS_WRITER=
AVM_ADDRESS_FORMATTER=
AVM_ADDRESS_WEATHER=
AVM_ADDRESS_ANALYSIS=

# Router's MongoDB connection (chat history/auth) — merged in from the old
# separate .env.local. Loaded by router/db.ts via config({ path: '../.env' }).
MONGODB_URI=
