PORT=3000

# Algorand testnet address that receives x402 payments (public, safe to share)
PAYTO_ADDRESS=

# Facilitator that verifies/settles payments.
# NOTE: x402.org/facilitator (the commonly cited default) advertises Algorand testnet
# under a truncated 32-char CAIP-2 network string that does NOT match the untruncated
# ALGORAND_TESTNET_CAIP2 constant exported by @x402-avm/avm@2.6.1, so route validation
# fails against it. Using the GoPlausible facilitator instead, which supports the exact
# network string this SDK version generates.
FACILITATOR_URL=https://facilitator.goplausible.xyz
